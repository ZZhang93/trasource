{
  "name": "trasource",
  "private": true,
  "version": "1.4.0",
  "license": "AGPL-3.0-only",
  "repository": "https://github.com/ZZhang93/trasource",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "test:frontend": "node --experimental-strip-types --test tests/frontend/*.test.ts",
    "test:backend": "node scripts/run-python-tests.mjs",
    "test": "npm run test:frontend && npm run test:backend",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "check": "npm run build && npm run check:i18n && npm run check:versions && npm run test",
    "prepare:sidecar:dev": "node scripts/prepare-sidecar.mjs --placeholder",
    "build:sidecar": "node scripts/prepare-sidecar.mjs --build",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "dompurify": "^3.4.12",
    "marked": "^17.0.4",
    "pinia": "^2.2.6",
    "vue": "^3.5.13",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^5.2.1",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vue-tsc": "^2.1.10"
  }
}
